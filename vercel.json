{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(sw.js|service-worker.js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "source": "/(.*)", "dest": "/index.html" }
  ]
}
